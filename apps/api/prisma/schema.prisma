generator client {
  provider   = "prisma-client"
  output     = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model Team {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(80)
  name      String   @db.VarChar(160)
  status    String   @default("ACTIVE") @db.VarChar(32)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1)

  users User[] @relation("TeamUsers")
  clients Client[] @relation("ClientTeam")
  jobOrders JobOrder[] @relation("JobOrderTeam")
  candidates Candidate[] @relation("CandidateTeam")
  candidateImports CandidateImportBatch[] @relation("ImportTeam")
  applications Application[] @relation("ApplicationTeam")
  savedViews SavedView[] @relation("SavedViewTeam")

  @@map("teams")
}

model User {
  id           String         @id @default(uuid()) @db.Uuid
  displayName  String         @map("display_name") @db.VarChar(160)
  email        String         @unique @db.VarChar(320)
  passwordHash String?        @map("password_hash") @db.VarChar(255)
  status       String         @default("INVITED") @db.VarChar(32)
  teamId       String?        @map("team_id") @db.Uuid
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  version      Int            @default(1)

  team         Team?          @relation("TeamUsers", fields: [teamId], references: [id])
  identityLinks IdentityLink[]
  sessions     Session[]
  userRoles    UserRole[]
  auditEvents  AuditEvent[]   @relation("AuditActor")
  ownedClients Client[] @relation("ClientOwner")
  ownedOrders JobOrder[] @relation("JobOrderOwner")
  ownedCandidates Candidate[] @relation("CandidateOwner")
  orderStatusHistory JobOrderStatusHistory[] @relation("JobOrderStatusActor")
  ownedApplications Application[] @relation("ApplicationOwner")
  applicationHistory ApplicationStatusHistory[] @relation("ApplicationHistoryActor")
  interviewHistory InterviewHistory[] @relation("InterviewHistoryActor")
  interviewParticipants InterviewParticipant[]
  ownedInterviews Interview[] @relation("InterviewOwner")
  importBatches CandidateImportBatch[] @relation("ImportOwner")
  duplicateResolutions CandidateDuplicateCase[] @relation("DuplicateResolver")
  mergeActions CandidateMergeAlias[] @relation("MergeActor")
  emailMatchDecisions EmailMatchDecision[] @relation("EmailMatchResolver")
  savedViews SavedView[] @relation("SavedViewOwner")
  entityNotes EntityNote[] @relation("EntityNoteAuthor")
  notifications Notification[] @relation("NotificationRecipient")

  @@index([teamId])
  @@map("users")
}

model IdentityLink {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  issuer    String   @db.VarChar(500)
  subject   String   @db.VarChar(500)
  email     String?  @db.VarChar(320)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, subject])
  @@index([userId])
  @@map("identity_links")
}

model Role {
  id          String       @id @default(uuid()) @db.Uuid
  code        String       @unique @db.VarChar(80)
  description String?      @db.VarChar(240)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  permissions RolePermission[]
  userRoles   UserRole[]

  @@map("roles")
}

model Permission {
  id          String       @id @default(uuid()) @db.Uuid
  code        String       @unique @db.VarChar(120)
  description String?      @db.VarChar(240)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  scope     String   @default("TEAM") @db.VarChar(32)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId, scope])
  @@index([roleId])
  @@map("user_roles")
}

model EntityNote {
  id           String   @id @default(uuid()) @db.Uuid
  entityType   String   @map("entity_type") @db.VarChar(64)
  entityId     String   @map("entity_id") @db.Uuid
  content      String   @db.VarChar(5000)
  authorUserId String   @map("author_user_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  author User @relation("EntityNoteAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, createdAt, id])
  @@index([authorUserId, createdAt])
  @@map("entity_notes")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  sessionHash      String    @unique @map("session_hash") @db.VarChar(128)
  csrfHash         String    @map("csrf_hash") @db.VarChar(128)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt       DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  version          Int       @default(1)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  auditEvents AuditEvent[] @relation("AuditSession")

  @@index([userId, expiresAt])
  @@index([expiresAt, revokedAt])
  @@map("sessions")
}

model SavedView {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  teamId     String?  @map("team_id") @db.Uuid
  resource   String   @db.VarChar(80)
  name       String   @db.VarChar(160)
  query      Json
  visibility String   @db.VarChar(16)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner User  @relation("SavedViewOwner", fields: [userId], references: [id], onDelete: Cascade)
  team  Team? @relation("SavedViewTeam", fields: [teamId], references: [id], onDelete: SetNull)

  @@unique([userId, resource, name])
  @@index([userId, resource, visibility])
  @@index([teamId, resource, visibility])
  @@map("saved_views")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  kind      String    @db.VarChar(64)
  severity  String    @default("INFO") @db.VarChar(16)
  params    Json      @default("{}")
  href      String?   @db.VarChar(500)
  readAt    DateTime? @map("read_at") @db.Timestamptz(6)
  dedupeKey String    @unique @map("dedupe_key") @db.VarChar(320)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt, id])
  @@index([userId, createdAt, id])
  @@map("notifications")
}

model AuditEvent {
  id            String    @id @default(uuid()) @db.Uuid
  occurredAt    DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)
  actorUserId   String?   @map("actor_user_id") @db.Uuid
  sessionId     String?   @map("session_id") @db.Uuid
  action        String    @db.VarChar(120)
  entityType    String    @map("entity_type") @db.VarChar(80)
  entityId      String?   @map("entity_id") @db.VarChar(120)
  correlationId String    @map("correlation_id") @db.VarChar(120)
  diffJson      Json      @default("{}") @map("diff_json")
  metadataJson  Json      @default("{}") @map("metadata_json")

  actorUser User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  session   Session? @relation("AuditSession", fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([entityType, entityId, occurredAt])
  @@map("audit_events")
}

model OutboxEvent {
  id              String    @id @default(uuid()) @db.Uuid
  eventType       String    @map("event_type") @db.VarChar(120)
  aggregateType   String    @map("aggregate_type") @db.VarChar(80)
  aggregateId     String    @map("aggregate_id") @db.VarChar(120)
  idempotencyKey  String    @unique @map("idempotency_key") @db.VarChar(240)
  schemaVersion   Int       @default(1) @map("schema_version")
  payload        Json
  state          String    @default("PENDING") @db.VarChar(32)
  availableAt    DateTime  @default(now()) @map("available_at") @db.Timestamptz(6)
  attempts       Int       @default(0)
  lockedAt       DateTime? @map("locked_at") @db.Timestamptz(6)
  publishedAt    DateTime? @map("published_at") @db.Timestamptz(6)
  lastError      String?   @map("last_error") @db.VarChar(1000)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([state, availableAt, createdAt], map: "outbox_events_pending_idx")
  @@map("outbox_events")
}

model JobAttempt {
  id             String    @id @default(uuid()) @db.Uuid
  outboxEventId  String?   @map("outbox_event_id") @db.Uuid
  queueName      String    @map("queue_name") @db.VarChar(120)
  jobKey         String    @map("job_key") @db.VarChar(240)
  state          String    @default("QUEUED") @db.VarChar(32)
  attempt        Int       @default(0)
  maxAttempts    Int       @default(5) @map("max_attempts")
  availableAt    DateTime  @default(now()) @map("available_at") @db.Timestamptz(6)
  startedAt      DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt     DateTime? @map("finished_at") @db.Timestamptz(6)
  lastError      String?   @map("last_error") @db.VarChar(1000)
  metadata       Json      @default("{}")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([state, availableAt, createdAt], map: "job_attempts_retry_idx")
  @@index([outboxEventId])
  @@map("job_attempts")
}

model IdempotencyRecord {
  id           String    @id @default(uuid()) @db.Uuid
  scopeKey     String    @unique @map("scope_key") @db.VarChar(320)
  requestHash  String    @map("request_hash") @db.VarChar(128)
  state        String    @default("IN_PROGRESS") @db.VarChar(32)
  statusCode   Int       @default(200) @map("status_code")
  responseJson Json?     @map("response_json")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([state, expiresAt], map: "idempotency_records_expiry_idx")
  @@map("idempotency_records")
}

model OidcLoginState {
  id        String    @id @default(uuid()) @db.Uuid
  stateHash String    @unique @map("state_hash") @db.VarChar(128)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([expiresAt, usedAt], map: "oidc_login_states_expiry_idx")
  @@map("oidc_login_states")
}

model CatalogItem {
  id        String          @id @default(uuid()) @db.Uuid
  type      String          @db.VarChar(32)
  code      String          @db.VarChar(80)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  versions CatalogVersion[]

  @@unique([type, code])
  @@map("catalog_items")
}

model CatalogVersion {
  id         String      @id @default(uuid()) @db.Uuid
  itemId     String      @map("item_id") @db.Uuid
  version    Int
  status     String      @default("DRAFT") @db.VarChar(32)
  labelVi    String      @map("label_vi") @db.VarChar(240)
  payload    Json        @default("{}")
  usageCount Int         @default(0) @map("usage_count")
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  item CatalogItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  orderRequirements JobOrderRequirementVersion[]
  jobOrdersUsingCatalog JobOrder[]

  @@unique([itemId, version])
  @@index([itemId, status])
  @@map("catalog_versions")
}

model InterviewQuestionTemplate {
  id        String                              @id @default(uuid()) @db.Uuid
  code      String                              @unique @db.VarChar(80)
  name      String                              @db.VarChar(160)
  createdAt DateTime                            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime                            @updatedAt @map("updated_at") @db.Timestamptz(6)

  versions InterviewQuestionTemplateVersion[]

  @@map("interview_question_templates")
}

model InterviewQuestionTemplateVersion {
  id         String                   @id @default(uuid()) @db.Uuid
  templateId String                   @map("template_id") @db.Uuid
  version    Int
  status     String                   @default("DRAFT") @db.VarChar(32)
  questions  Json
  createdAt  DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)

  template InterviewQuestionTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)

  @@unique([templateId, version])
  @@index([templateId, status])
  @@map("interview_question_template_versions")
}

model Client {
  id               String          @id @default(uuid()) @db.Uuid
  code             String          @unique @db.VarChar(80)
  name             String          @db.VarChar(240)
  organizationType String          @map("organization_type") @db.VarChar(120)
  industryLabels   Json            @default("[]") @map("industry_labels")
  region           String          @db.VarChar(160)
  ownerId          String          @map("owner_id") @db.Uuid
  teamId           String?         @map("team_id") @db.Uuid
  status           String          @default("PROSPECT") @db.VarChar(32)
  notes            String?         @db.VarChar(2000)
  version          Int             @default(1)
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner      User                     @relation("ClientOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  team       Team?                    @relation("ClientTeam", fields: [teamId], references: [id], onDelete: SetNull)
  contact    ClientContact?
  jobOrders  JobOrder[]

  @@index([status, updatedAt, id])
  @@index([teamId, status, updatedAt, id])
  @@map("clients")
}

model ClientContact {
  id        String   @id @default(uuid()) @db.Uuid
  clientId  String   @unique @map("client_id") @db.Uuid
  name      String   @db.VarChar(160)
  email     String?  @db.VarChar(320)
  phone     String?  @db.VarChar(40)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  client Client @relation(fields: [clientId], references: [id], onDelete: Restrict)

  @@map("client_contacts")
}

model JobOrder {
  id                         String                         @id @default(uuid()) @db.Uuid
  code                       String                         @unique @db.VarChar(80)
  position                   String                         @db.VarChar(240)
  clientId                   String                         @map("client_id") @db.Uuid
  industryLabel              String                         @map("industry_label") @db.VarChar(160)
  occupation                 String                         @db.VarChar(160)
  location                   String                         @db.VarChar(160)
  target                     Int
  deadline                   DateTime                       @db.Timestamptz(6)
  ownerId                    String                         @map("owner_id") @db.Uuid
  teamId                     String?                        @map("team_id") @db.Uuid
  status                     String                         @default("DRAFT") @db.VarChar(32)
  requirementVersion         Int                            @default(1) @map("requirement_version")
  requirementCatalogVersionId String                       @map("requirement_catalog_version_id") @db.Uuid
  requirementSnapshot        Json                           @map("requirement_snapshot")
  activeApplications         Int                            @default(0) @map("active_applications")
  passedApplications         Int                            @default(0) @map("passed_applications")
  suppliedApplications       Int                            @default(0) @map("supplied_applications")
  version                    Int                            @default(1)
  createdAt                  DateTime                       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime                       @updatedAt @map("updated_at") @db.Timestamptz(6)

  client              Client                         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  owner               User                           @relation("JobOrderOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  team                Team?                          @relation("JobOrderTeam", fields: [teamId], references: [id], onDelete: SetNull)
  requirementCatalog  CatalogVersion                 @relation(fields: [requirementCatalogVersionId], references: [id], onDelete: Restrict)
  requirements        JobOrderRequirementVersion[]
  statusHistory       JobOrderStatusHistory[]
  applications        Application[]

  @@index([status, deadline, id])
  @@index([clientId, status, deadline, id])
  @@index([teamId, status, deadline, id])
  @@map("job_orders")
}

model JobOrderRequirementVersion {
  id                 String   @id @default(uuid()) @db.Uuid
  jobOrderId         String   @map("job_order_id") @db.Uuid
  version            Int
  catalogVersionId   String   @map("catalog_version_id") @db.Uuid
  snapshot           Json
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  jobOrder       JobOrder       @relation(fields: [jobOrderId], references: [id], onDelete: Restrict)
  catalogVersion CatalogVersion @relation(fields: [catalogVersionId], references: [id], onDelete: Restrict)

  @@unique([jobOrderId, version])
  @@index([jobOrderId, createdAt, id])
  @@map("job_order_requirement_versions")
}

model JobOrderStatusHistory {
  id         String   @id @default(uuid()) @db.Uuid
  jobOrderId String   @map("job_order_id") @db.Uuid
  fromStatus String   @map("from_status") @db.VarChar(32)
  toStatus   String   @map("to_status") @db.VarChar(32)
  actorUserId String  @map("actor_user_id") @db.Uuid
  reason     String?  @db.VarChar(1000)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  jobOrder JobOrder @relation(fields: [jobOrderId], references: [id], onDelete: Restrict)
  actor    User     @relation("JobOrderStatusActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([jobOrderId, createdAt, id])
  @@map("job_order_status_history")
}

model Candidate {
  id                    String   @id @default(uuid()) @db.Uuid
  code                  String   @unique @db.VarChar(80)
  name                  String   @db.VarChar(240)
  normalizedName        String   @map("normalized_name") @db.VarChar(240)
  industryLabels        Json     @map("industry_labels")
  occupation            String   @db.VarChar(160)
  japaneseLevel         String   @map("japanese_level") @db.VarChar(40)
  emailCiphertext       String?  @map("email_ciphertext") @db.Text
  emailBlindIndex       String?  @map("email_blind_index") @db.VarChar(64)
  phoneCiphertext       String?  @map("phone_ciphertext") @db.Text
  phoneBlindIndex       String?  @map("phone_blind_index") @db.VarChar(64)
  addressCiphertext     String?  @map("address_ciphertext") @db.Text
  passportCiphertext    String?  @map("passport_ciphertext") @db.Text
  passportBlindIndex    String?  @map("passport_blind_index") @db.VarChar(64)
  source                String   @db.VarChar(120)
  recordStatus          String   @default("ACTIVE") @map("record_status") @db.VarChar(32)
  readinessStatus       String   @default("POTENTIAL") @map("readiness_status") @db.VarChar(32)
  contactabilityStatus  String   @default("CONTACTABLE") @map("contactability_status") @db.VarChar(40)
  ownerId               String   @map("owner_id") @db.Uuid
  teamId                String?  @map("team_id") @db.Uuid
  version               Int      @default(1)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner    User                    @relation("CandidateOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  team     Team?                   @relation("CandidateTeam", fields: [teamId], references: [id], onDelete: SetNull)
  profiles CandidateOccupationProfile[]
  applications Application[]
  importsAsCreated CandidateImportRow[] @relation("ImportedCandidate")
  duplicateSources CandidateDuplicateCase[] @relation("DuplicateSource")
  duplicateTargets CandidateDuplicateCase[] @relation("DuplicateTarget")
  mergeAliasesAsWinner CandidateMergeAlias[] @relation("MergeWinner")
  mergeAliasesAsLoser CandidateMergeAlias[] @relation("MergeLoser")
  emailConversations EmailConversation[]
  emailMatchDecisions EmailMatchDecision[] @relation("EmailMatchCandidate")

  @@index([normalizedName])
  @@index([emailBlindIndex])
  @@index([phoneBlindIndex])
  @@index([passportBlindIndex])
  @@index([teamId, readinessStatus, updatedAt, id])
  @@index([ownerId, recordStatus, updatedAt, id])
  @@map("candidates")
}

model CandidateOccupationProfile {
  id              String   @id @default(uuid()) @db.Uuid
  candidateId     String   @map("candidate_id") @db.Uuid
  industryLabel   String   @map("industry_label") @db.VarChar(160)
  occupation      String   @db.VarChar(160)
  yearsExperience Float    @map("years_experience")
  skills          Json
  desiredLocation String?  @map("desired_location") @db.VarChar(160)
  attributes      Json     @default("{}")
  schemaVersionId String?  @map("schema_version_id") @db.VarChar(120)
  status          String   @default("PRIMARY") @db.VarChar(32)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Restrict)

  @@unique([candidateId, industryLabel, occupation])
  @@index([candidateId, createdAt, id])
  @@index([occupation, status])
  @@map("candidate_occupation_profiles")
}

model CandidateImportBatch {
  id              String   @id @default(uuid()) @db.Uuid
  ownerId         String   @map("owner_id") @db.Uuid
  teamId          String?  @map("team_id") @db.Uuid
  fileName        String   @map("file_name") @db.VarChar(240)
  checksum        String   @db.VarChar(128)
  status          String   @default("UPLOADED") @db.VarChar(32)
  mappingVersion  String   @default("v1") @map("mapping_version") @db.VarChar(40)
  previewTokenHash String? @map("preview_token_hash") @db.VarChar(128)
  previewExpiresAt DateTime? @map("preview_expires_at") @db.Timestamptz(6)
  totalRows       Int      @default(0) @map("total_rows")
