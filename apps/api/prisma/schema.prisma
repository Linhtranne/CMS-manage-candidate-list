  requesterId    String   @map("requester_id") @db.Uuid
  purpose        String   @db.VarChar(500)
  scopeSnapshot  Json     @map("scope_snapshot")
  includedFields Json     @map("included_fields")
  status         String   @default("QUEUED") @db.VarChar(32)
  objectKey      String?  @map("object_key") @db.VarChar(500)
  expiresAt      DateTime? @map("expires_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  @@index([requesterId, status, createdAt])
  @@map("report_export_jobs")
}

model SupplyJourney {
  id                String   @id @default(uuid()) @db.Uuid
  candidateId       String   @map("candidate_id") @db.Uuid
  applicationId     String   @map("application_id") @db.Uuid
  templateVersionId String   @map("template_version_id") @db.Uuid
  templateChecksum  String   @map("template_checksum") @db.VarChar(71)
  ownerUserId       String   @map("owner_user_id") @db.Uuid
  teamId            String?  @map("team_id") @db.Uuid
  status            String   @default("ACTIVE") @db.VarChar(32)
  contextSnapshot   Json     @map("context_snapshot")
  startedAt         DateTime @map("started_at") @db.Timestamptz(6)
  completedAt       DateTime? @map("completed_at") @db.Timestamptz(6)
  cancelReason      String?  @map("cancel_reason") @db.VarChar(1000)
  idempotencyKey    String   @unique @map("idempotency_key") @db.VarChar(320)
  version           Int      @default(1)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  milestones JourneyMilestone[]
  history    JourneyMilestoneHistory[]

  @@index([candidateId, status, updatedAt, id])
  @@index([ownerUserId, status, updatedAt, id])
  @@index([teamId, status, updatedAt, id])
  @@map("supply_journeys")
}

model JourneyMilestone {
  id                   String   @id @default(uuid()) @db.Uuid
  journeyId            String   @map("journey_id") @db.Uuid
  templateMilestoneId  String?  @map("template_milestone_id") @db.Uuid
  code                 String   @db.VarChar(80)
  name                 String   @db.VarChar(240)
  sequence             Int
  status               String   @default("NOT_STARTED") @db.VarChar(32)
  dependencyCodes      Json     @default("[]") @map("dependency_codes")
  ownerUserId          String   @map("owner_user_id") @db.Uuid
  dueAt                DateTime? @map("due_at") @db.Timestamptz(6)
  completedAt          DateTime? @map("completed_at") @db.Timestamptz(6)
  blockerParty         String?  @map("blocker_party") @db.VarChar(32)
  blockerReason        String?  @map("blocker_reason") @db.VarChar(1000)
  expectedResolution   String?  @map("expected_resolution") @db.VarChar(1000)
  waivedBy             String?  @map("waived_by") @db.Uuid
  waiveReason          String?  @map("waive_reason") @db.VarChar(1000)
  waivedAt             DateTime? @map("waived_at") @db.Timestamptz(6)
  notApplicableReason  String?  @map("not_applicable_reason") @db.VarChar(1000)
  checklistData        Json     @default("{}") @map("checklist_data")
  evidenceRequirement  Json     @default("[]") @map("evidence_requirement")
  attemptNo            Int      @default(1) @map("attempt_no")
  version              Int      @default(1)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  journey SupplyJourney @relation(fields: [journeyId], references: [id], onDelete: Restrict)

  @@unique([journeyId, code])
  @@index([journeyId, sequence])
  @@index([ownerUserId, status, dueAt, id])
  @@map("journey_milestones")
}

model JourneyMilestoneHistory {
  id          String   @id @default(uuid()) @db.Uuid
  journeyId   String   @map("journey_id") @db.Uuid
  milestoneId String?  @map("milestone_id") @db.Uuid
  fromStatus  String?  @map("from_status") @db.VarChar(32)
  toStatus    String   @map("to_status") @db.VarChar(32)
  actorUserId String   @map("actor_user_id") @db.Uuid
  reason      String?  @db.VarChar(1000)
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  journey SupplyJourney @relation(fields: [journeyId], references: [id], onDelete: Restrict)

  @@index([journeyId, createdAt, id])
  @@index([milestoneId, createdAt, id])
  @@map("journey_milestone_history")
}

model JourneyMilestoneAttempt {
  id          String   @id @default(uuid()) @db.Uuid
  milestoneId String   @map("milestone_id") @db.Uuid
  attemptNo   Int      @map("attempt_no")
  status      String   @default("OPEN") @db.VarChar(32)
  reason      String   @db.VarChar(1000)
  openedBy    String   @map("opened_by") @db.Uuid
  openedAt    DateTime @default(now()) @map("opened_at") @db.Timestamptz(6)
  closedAt    DateTime? @map("closed_at") @db.Timestamptz(6)
  result      Json?

  @@unique([milestoneId, attemptNo])
  @@index([milestoneId, status, attemptNo])
  @@map("journey_milestone_attempts")
}

model Document {
  id             String   @id @default(uuid()) @db.Uuid
  candidateId    String   @map("candidate_id") @db.Uuid
  ownerUserId    String   @map("owner_user_id") @db.Uuid
  teamId         String?  @map("team_id") @db.Uuid
  title          String   @db.VarChar(240)
  category       String   @db.VarChar(80)
  status         String   @default("QUARANTINED") @db.VarChar(32)
  latestVersionNo Int     @default(1) @map("latest_version_no")
  legalHold      Boolean  @default(false) @map("legal_hold")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  versions       DocumentVersion[]
  links          DocumentLink[]
  accessAudits   DocumentAccessAudit[]
  @@index([candidateId, status, updatedAt, id])
  @@index([ownerUserId, status, updatedAt, id])
  @@index([teamId, status, updatedAt, id])
  @@map("documents")
}

model DocumentVersion {
  id            String   @id @default(uuid()) @db.Uuid
  documentId    String   @map("document_id") @db.Uuid
  versionNo     Int      @map("version_no")
  objectKey     String   @map("object_key") @db.VarChar(500)
  sizeBytes     BigInt   @map("size_bytes")
  checksum      String   @db.VarChar(128)
  claimedMime   String   @map("claimed_mime") @db.VarChar(120)
  detectedMime  String?  @map("detected_mime") @db.VarChar(120)
  status        String   @default("QUARANTINED") @db.VarChar(32)
  rejectionReason String? @map("rejection_reason") @db.VarChar(500)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  document      Document @relation(fields: [documentId], references: [id], onDelete: Restrict)
  @@unique([documentId, versionNo])
  @@index([documentId, status, versionNo])
  @@map("document_versions")
}

model DocumentLink {
  id          String   @id @default(uuid()) @db.Uuid
  documentId  String   @map("document_id") @db.Uuid
  candidateId String   @map("candidate_id") @db.Uuid
  journeyId   String?  @map("journey_id") @db.Uuid
  milestoneId String?  @map("milestone_id") @db.Uuid
  linkedBy    String   @map("linked_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  document    Document @relation(fields: [documentId], references: [id], onDelete: Restrict)
  @@unique([documentId, candidateId, journeyId, milestoneId])
  @@index([candidateId, journeyId, milestoneId])
  @@map("document_links")
}

model DocumentAccessAudit {
  id         String   @id @default(uuid()) @db.Uuid
  documentId String   @map("document_id") @db.Uuid
  versionNo  Int      @map("version_no")
  actorUserId String  @map("actor_user_id") @db.Uuid
  action     String   @db.VarChar(40)
  requestId  String?  @map("request_id") @db.VarChar(120)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  document   Document @relation(fields: [documentId], references: [id], onDelete: Restrict)
  @@index([documentId, createdAt, id])
  @@map("document_access_audits")
}

model RetentionPolicy {
  id           String   @id @default(uuid()) @db.Uuid
