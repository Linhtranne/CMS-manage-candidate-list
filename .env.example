NEXT_PUBLIC_API_BASE_URL=http://localhost:3100/api/v1
NEXT_PUBLIC_MSW_ENABLED=false
NEXT_PUBLIC_APP_ENV=development
SENTRY_DSN=

# Backend runtime (never commit real values)
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
APP_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql://cms_owner:cms_owner_dev@localhost:5432/cms_candidate_supply
DATABASE_RUNTIME_ROLE=cms_runtime
REDIS_URL=redis://localhost:6379
QUEUE_ENABLED=false
QUEUE_PREFIX=cms
QUEUE_NAMES=outbox,reconcile,mail-ingest,mail-sync,mail-subscription,file-scan
QUEUE_CONCURRENCY=5
OTEL_ENABLED=false
OTEL_SERVICE_NAME=cms-candidate-supply-api
OIDC_ISSUER=
OIDC_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
OIDC_CLIENT_SECRET=replace-with-oidc-client-secret
OIDC_REDIRECT_URI=
OIDC_AUDIENCE=
OIDC_APPROVAL_RECORD_FILE=
# High-risk activation is disabled unless the matching server-owned approval
# record is mounted and validates for the current environment.
PRODUCTION_SEED_ACTIVATION=false
CATALOG_APPROVAL_RECORD_FILE=
DOCUMENTS_ENABLED=false
DOCUMENT_APPROVAL_RECORD_FILE=
BULK_EXPORT_ENABLED=false
EXPORT_APPROVAL_RECORD_FILE=
PURGE_ENABLED=false
RETENTION_APPROVAL_RECORD_FILE=
BREAK_GLASS_ENABLED=false
BREAK_GLASS_APPROVAL_RECORD_FILE=
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_KMS_KEY_ID=
STORAGE_UPLOAD_TTL_SECONDS=300
STORAGE_DOWNLOAD_TTL_SECONDS=60
MALWARE_SCANNER_ENDPOINT=
MALWARE_SCANNER_TIMEOUT_MS=5000
# DISABLED is the safe default. FAKE is synthetic-only for development/test; real providers require DEC-003.
MAIL_PROVIDER=DISABLED
MAIL_PROVIDER_APPROVAL_RECORD_FILE=
# Required for an enabled staging provider; every outbound recipient must be listed here.
MAIL_CANARY_RECIPIENTS=
ENCRYPTION_KEY=development-only-encryption-key-32
SESSION_SECRET=development-only-session-secret-32
COOKIE_SECURE=false
# Local-only password login seed. Keep these values out of production environments.
LOCAL_AUTH_EMAIL=admin@local.test
LOCAL_AUTH_PASSWORD=LocalOnly-2026!
LOCAL_AUTH_DISPLAY_NAME=Local Admin
LOCAL_AUTH_ROLES=MANAGER,CONFIG_ADMIN
# Production release evidence files are injected by CI/Operations, never committed as secrets.
# SAST_ARTIFACT=/secure/evidence/sast.json
# DEPENDENCY_SCAN_ARTIFACT=/secure/evidence/dependency-scan.json
# SECRET_SCAN_ARTIFACT=/secure/evidence/secret-scan.json
# CONTAINER_SCAN_ARTIFACT=/secure/evidence/container-scan.json
# SBOM_ARTIFACT=/secure/evidence/sbom.cdx.json
# DAST_ARTIFACT=/secure/evidence/dast.json

# Production compose requires immutable image references; inject digest-pinned
# values from the release registry/secret environment rather than committing them.
# API_IMAGE=registry.example.invalid/cms/api@sha256:<64-hex-digest>
# MIGRATION_IMAGE=registry.example.invalid/cms/api-migrate@sha256:<64-hex-digest>
# WEB_IMAGE=registry.example.invalid/cms/web@sha256:<64-hex-digest>
# POSTGRES_IMAGE=postgres@sha256:<64-hex-digest>
# REDIS_IMAGE=redis@sha256:<64-hex-digest>
