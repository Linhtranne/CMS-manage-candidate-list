{
  "name": "@cms/contracts",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "openapi-typescript openapi/cms.yaml -o src/generated/schema.d.ts",
    "check-breaking": "node scripts/check-breaking-change.mjs",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
