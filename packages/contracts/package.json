    "build": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/js-yaml": "4.0.9",
    "@types/node": "26.2.0",
    "js-yaml": "4.3.1",
    "openapi-typescript": "7.13.0",
    "vitest": "4.1.10"
  }
}
